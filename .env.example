# 모든 값은 선택 사항이다. 설정하지 않으면 아래 기본값이 쓰인다.
# 잘못된 값(범위 밖 정수 등)은 부팅 시점에 즉시 에러로 알려준다.

# --- 서버 ---------------------------------------------------------------
# 컨테이너/PaaS에서 외부 접근이 되려면 0.0.0.0이어야 한다.
HOST=0.0.0.0
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- 리버스 프록시 ------------------------------------------------------
# 신뢰하는 프록시 홉 수. 0이면 X-Forwarded-For를 아예 무시하고 TCP 소켓의
# 원격 주소만 rate limit 키로 쓴다.
#
# 이 값을 올리기 전에 실제로 프록시 뒤에 있는지 반드시 확인할 것.
# 프록시가 없는데 1 이상으로 두면, 클라이언트가 헤더를 위조해 rate limit을
# 통째로 무력화할 수 있다.
#   nginx 한 대 뒤       -> 1
#   CDN + nginx 두 단 뒤 -> 2
TRUST_PROXY_HOPS=0

# --- 기기 종류 (에어컨 / 온풍기) ----------------------------------------
# auto   : 아래 WINTER_MONTHS에 현재 월이 들어가면 온풍기, 아니면 에어컨
# aircon : 계절과 무관하게 에어컨 고정
# heater : 계절과 무관하게 온풍기 고정
#
# 공유 기기이므로 서버가 정해서 접속자 전원에게 같은 값을 내려준다.
# 판단 기준은 서버의 로컬 시간대다. 배포 환경의 TZ를 맞춰 둘 것.
DEVICE_MODE=auto

# 온풍기로 취급할 월. 남반구라면 5,6,7,8 처럼 바꾼다.
WINTER_MONTHS=11,12,1,2,3

# 서비스가 자기 시각으로 삼을 IANA 시간대. 계절 판정과 통계의 "오늘" 경계에
# 함께 쓴다. 비워두면 서버 프로세스의 로컬 시간대를 쓰는데, 대부분의 컨테이너는
# UTC라 한국 기준으로 운영한다면 명시하는 편이 낫다.
# 잘못된 이름을 넣으면 부팅 시점에 에러가 난다.
# (예전 이름 SEASON_TIMEZONE 도 계속 받는다)
# SERVICE_TIMEZONE=Asia/Seoul

# 서버가 계절이 바뀌는 순간에도 켜져 있을 수 있어 주기적으로 다시 확인한다.
# 바뀌면 접속 중인 클라이언트에 deviceChange로 알린다. (기본 1시간)
DEVICE_RECHECK_INTERVAL_MS=3600000

# 온풍기 전용 이미지는 아직 없다. public/ 아래에 heater0.png,
# heater-fan.png, heater-air.png 를 넣으면 서버가 자동으로 그 경로를
# 내려보낸다. 없는 파일은 파일 단위로 에어컨 이미지로 폴백한다.

# --- 온도 ---------------------------------------------------------------
TEMP_MIN=18
TEMP_MAX=30
# 저장된 상태가 없을 때의 시작 온도 (기본: TEMP_MIN)
TEMP_INITIAL=18

# --- 상태 영속화 --------------------------------------------------------
# 끄면 재시작할 때마다 온도가 TEMP_INITIAL로 돌아간다.
PERSIST_STATE=true
STATE_FILE=./data/state.json
# 마지막 변경 후 이만큼 잠잠해지면 디스크에 쓴다 (ms)
PERSIST_DEBOUNCE_MS=2000

# --- 통계 ---------------------------------------------------------------
# 접속자 수, 이름별 순위(오늘/역대), 최근 기록, 시간대별 활동.
# 집계는 전부 메모리에서 하고 SQLite에는 주기적으로 백업만 한다.
# 끄면 순위/기록/그래프가 비고 접속자 수만 계속 동작한다.
STATS_ENABLED=true
STATS_FILE=./data/stats.db

# 접속자 수 브로드캐스트 주기. 값이 바뀌었을 때만 보낸다.
# 접속/해제마다 보내면 사람이 많을 때 O(N^2)가 되므로 주기로 묶는다.
STATS_ONLINE_INTERVAL_MS=5000

# 메모리 집계를 디스크에 반영하는 주기.
STATS_FLUSH_INTERVAL_MS=5000

# 순위에 유지할 최대 이름 수. 닉네임에 인증이 없어서 스크립트가 매번 다른
# 이름을 보내면 집계가 무한히 자란다(실측: 100만 항목 58MB).
# 이 값을 넘으면 상위 500개만 남기고 잘라낸다.
STATS_MAX_NAMES=2000

# 최근 기록 링버퍼 크기(메모리에만 있다. 재시작하면 비워진다).
# 화면에는 이 중 최근 50건까지 보여준다.
STATS_RECENT_SIZE=500

# 시간대별 롤업 보관 기간. 화면에는 24시간치만 쓴다.
STATS_RETENTION_HOURS=48

# --- 표시용 태그 --------------------------------------------------------
# 접속자를 화면에서 구분하는 태그(가온#7c2)를 만들 때 쓰는 비밀키.
# 비워두면 서버가 한 번 만들어 통계 DB에 저장하고 이후 재사용한다.
# 인스턴스를 여러 개 띄운다면 같은 값을 명시해야 태그가 서로 일치한다.
# (16자 이상)
# IDENTITY_SECRET=

# --- 관리 (kick / 차단) --------------------------------------------------
# 토큰을 설정해야 /api/admin/* 라우트와 /admin.html 이 동작한다.
# 미설정이면 라우트 자체가 등록되지 않는다(404). 16자 이상.
# ADMIN_TOKEN=

# 차단 목록 저장 위치. 재시작해도 유지된다.
BAN_FILE=./data/bans.db

# kick 할 때 기본으로 제안하는 차단 시간(분). 0이면 끊기만 한다.
# 참고: IP 기준 차단이라 VPN이나 모바일 IP 변경으로 우회된다.
BAN_DEFAULT_MINUTES=10

# --- 닉네임 -------------------------------------------------------------
# grapheme(사용자가 인지하는 글자) 기준 길이
NICKNAME_MAX_LENGTH=9
NICKNAME_FALLBACK=익명

# --- Rate limit ---------------------------------------------------------
# DURATION_SECONDS 동안 POINTS회까지 허용, 초과하면 BLOCK_SECONDS 동안 차단
RATE_LIMIT_POINTS=10
RATE_LIMIT_DURATION_SECONDS=2
RATE_LIMIT_BLOCK_SECONDS=5

# --- 보안 ---------------------------------------------------------------
# socket.io 페이로드는 닉네임 문자열 하나뿐이라 1KB면 충분하다 (기본값 1MB)
MAX_HTTP_BUFFER_SIZE=1024
# HSTS는 https 뒤에서만 켤 것. 0이면 헤더를 붙이지 않는다. (1년 = 31536000)
HSTS_MAX_AGE=0
# 기본 CSP는 외부 출처를 전혀 허용하지 않는다. 꼭 필요할 때만 덮어쓸 것.
# CONTENT_SECURITY_POLICY=default-src 'self'; ...
