# dependencies
node_modules/
.npm/

# runtime state (shared thermostat value persisted by the server)
data/

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# env / secrets
.env
.env.*
!.env.example

# build & tooling caches
coverage/
.nyc_output/
*.tsbuildinfo

# 이미지 원본. public/img/ 에는 webp로 변환한 것만 두고, 1254px PNG 원본은
# 서빙하지도 커밋하지도 않는다 (6장 합계 7.3MB -> 416KB).
# 다시 만들려면: ffmpeg -i in.png -vf scale=640:640:flags=lanczos #                       -c:v libwebp -pix_fmt yuva420p -quality 82 out.webp
assets/img-src/

# TypeScript 산출물. 소스는 src/ 이며 tsc가 아래로 뱉는다.
#   src/server + src/shared -> dist/
#   src/client + src/shared -> public/js/
# npm install 시 prepare 스크립트가 자동으로 빌드한다.
dist/
public/js/

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
