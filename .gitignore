# dependencies
node_modules/
.npm/

# runtime state (shared thermostat value persisted by the server)
data/

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# env / secrets
.env
.env.*
!.env.example

# build & tooling caches
coverage/
.nyc_output/
*.tsbuildinfo

# TypeScript 산출물. 소스는 src/ 이며 tsc가 아래로 뱉는다.
#   src/server + src/shared -> dist/
#   src/client + src/shared -> public/js/
# npm install 시 prepare 스크립트가 자동으로 빌드한다.
dist/
public/js/

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
