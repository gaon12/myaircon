{
  "name": "myaircon",
  "version": "2.0.0",
  "description": "Online air conditioner — a thermostat everyone on the internet shares, with a brown-noise generator built on the Web Audio API.",
  "keywords": [
    "aircon",
    "thermostat",
    "brown-noise",
    "web-audio",
    "audioworklet",
    "socket.io",
    "fastify",
    "realtime"
  ],
  "homepage": "https://github.com/gaon12/myaircon#readme",
  "bugs": {
    "url": "https://github.com/gaon12/myaircon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaon12/myaircon.git"
  },
  "license": "ISC",
  "author": "gaon12 <gokirito12@gmail.com>",
  "contributors": [
    "codingapple (https://github.com/codingapple1) — original author"
  ],
  "type": "module",
  "main": "dist/server/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "prestart": "npm run build",
    "start": "node dist/server/server.js",
    "dev": "node --watch src/server/server.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "ci": "biome ci . && npm run typecheck && node --test \"test/**/*.test.ts\"",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "rate-limiter-flexible": "^11.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
